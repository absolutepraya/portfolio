{
  "name": "portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "knip": {
    "ignoreDependencies": [
      "serve",
      "husky"
    ]
  },
  "scripts": {
    "dev": "bun run vite",
    "build": "bun run vite build && bun run scripts/prerender.js && bun run scripts/generate-redirects.js",
    "check": "bunx biome check --write --unsafe .",
    "format": "bunx biome format --write .",
    "format:check": "bunx biome format .",
    "lint": "bunx biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "start": "bun run serve -s dist",
    "knip": "knip",
    "react-doctor": "react-doctor --json --json-out .react-doctor-baseline.json --blocking none",
    "react-doctor:staged": "react-doctor --staged --blocking none",
    "react-doctor:ci": "bun run scripts/check-react-doctor.js",
    "bundle-size": "bun run scripts/check-bundle-size.js",
    "smoke:deployment": "bun scripts/smoke-cloudflare-deployment.mjs",
    "verify": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run react-doctor:ci && bun run knip && bun run build && bun run bundle-size",
    "heroku-prebuild": "rm -f package-lock.json",
    "heroku-postbuild": "bun install && bun run vite build && bun run scripts/prerender.js && bun run scripts/generate-redirects.js && rm -rf .cache/puppeteer node_modules/puppeteer node_modules/@puppeteer"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@tabler/icons-react": "^3.36.1",
    "@types/opentype.js": "^1.3.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "moment-timezone": "^0.6.0",
    "opentype.js": "^1.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "serve": "^14.2.5",
    "shadcn": "^4.0.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.2",
    "@tailwindcss/vite": "^4.2.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "husky": "^9.1.7",
    "knip": "^5.84.1",
    "puppeteer": "^24.37.4",
    "react-doctor": "0.8.3",
    "react-grab": "0.1.50",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  }
}
