{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "web"
      }
    }
  ],
  "services": {
    "web": {
      "root": ".",
      "framework": "vite",
      "entrypoint": "."
    }
  },
  "redirects": [
    {
      "source": "/tracklist-buat-gina",
      "destination": "https://open.spotify.com/playlist/0pMfUQjO2zDTXEqzu8IJqD?si=4c041b4928f44860",
      "statusCode": 302
    }
  ]
}
